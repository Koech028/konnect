DJANGO_SECRET_KEY=replace-this-in-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,

# Blank uses local SQLite. Add Supabase PostgreSQL URL for a production deployment.
DATABASE_URL=

# With no SMTP settings, local development prints OTP emails to the console.
# Supplying SMTP settings enables actual email delivery in development too.
# Production requires valid SMTP credentials and a verified sender address.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=noreply@linkup.local
# Cloudflare R2 object storage. Never expose the R2 secret in frontend variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# LiveKit server credentials. Keep the API secret on the backend only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser push notifications (keep the private key server-side).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=
