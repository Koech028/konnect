DJANGO_SECRET_KEY=replace-this-in-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Blank uses local SQLite. Add Supabase PostgreSQL URL for a production deployment.
DATABASE_URL=

# Local development uses console email. Configure SMTP before deploying.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=noreply@linkup.local
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Cloudflare R2 object storage. Never expose the R2 secret in frontend variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
